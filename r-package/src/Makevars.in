PKG_CPPFLAGS = -DUSING_R
OBJECTS = error.o exog.o FindW.o init.o Lyapunov.o rp_dpstrf.o \
  sb03md-complete.o sb03mdGateway.o varmapack_acvf.o varmapack_autocov.o \
  varmapack_ma_specrad.o varmapack_psi.o varmapack_R.o varmapack_sim.o \
  varmapack_simx.o varmapack_specrad.o varmapack_testcase.o \
  varmapack_testcasex.o VarmaPackUtil.o VYW.o
PKG_LIBS = $(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS) -lm

all: $(SHLIB)

sb03md-complete.o: sb03md-complete.F
	$(FC) $(ALL_FFLAGS) -c $< -o $@
